alse,\"schema\":{\"type\":\"string\"}},{\"description\":\"Omit background in screenshot\",\"in\":\"query\",\"name\":\"screenshot.omitBackground\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Screenshot image format\",\"in\":\"query\",\"name\":\"screenshot.type\",\"required\":false,\"schema\":{\"enum\":[\"png\",\"jpeg\",\"webp\"],\"type\":\"string\"}},{\"description\":\"Custom scripts to inject\",\"in\":\"query\",\"name\":\"scripts\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Scroll configuration\",\"in\":\"query\",\"name\":\"scroll\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Custom CSS styles to inject\",\"in\":\"query\",\"name\":\"styles\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Stale cache time-to-live in milliseconds\",\"in\":\"query\",\"name\":\"staleTtl\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"Request timeout in milliseconds\",\"in\":\"query\",\"name\":\"timeout\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"Cache time-to-live in milliseconds\",\"in\":\"query\",\"name\":\"ttl\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"Enable video extraction\",\"in\":\"query\",\"name\":\"video\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Viewport dimensions\",\"in\":\"query\",\"name\":\"viewport\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"CSS selector to wait for before capturing\",\"in\":\"query\",\"name\":\"waitForSelector\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Time to wait before capturing in milliseconds\",\"in\":\"query\",\"name\":\"waitForTimeout\",\"required\":false,\"schema\":{\"type\":\"integer\"}},{\"description\":\"Wait until specific page load event\",\"in\":\"query\",\"name\":\"waitUntil\",\"required\":false,\"schema\":{\"enum\":[\"load\",\"domcontentloaded\",\"n