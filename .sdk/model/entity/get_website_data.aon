when pdf=true)\",\"properties\":{\"size\":{\"type\":\"integer\"},\"size_pretty\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"},\"url\":{\"format\":\"uri\",\"type\":\"string\"}},\"type\":\"object\"},\"publisher\":{\"description\":\"Page publisher\",\"type\":\"string\"},\"screenshot\":{\"description\":\"Screenshot data (when screenshot=true)\",\"properties\":{\"height\":{\"type\":\"integer\"},\"size\":{\"type\":\"integer\"},\"size_pretty\":{\"type\":\"string\"},\"type\":{\"type\":\"string\"},\"url\":{\"format\":\"uri\",\"type\":\"string\"},\"width\":{\"type\":\"integer\"}},\"type\":\"object\"},\"technologies\":{\"description\":\"Detected technologies (when technologies=true)\",\"items\":{\"properties\":{\"categories\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"},\"confidence\":{\"type\":\"integer\"},\"icon\":{\"type\":\"string\"},\"name\":{\"type\":\"string\"},\"version\":{\"type\":\"string\"},\"website\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"title\":{\"description\":\"Page title\",\"type\":\"string\"},\"url\":{\"description\":\"Canonical URL\",\"format\":\"uri\",\"type\":\"string\"}},\"type\":\"object\"},\"status\":{\"description\":\"Status of the API request\",\"enum\":[\"success\",\"error\"],\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Successful response with extracted data\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"message\":{\"description\":\"Error message\",\"type\":\"string\"},\"status\":{\"enum\":[\"error\"],\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Bad request - Invalid parameters\"},\"429\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"code\":{\"description\":\"Error code\",\"type\":\"string\"},\"message\":{\"description\":\"Rate limit error message\",\"type\":\"string\"},\"status\":{\"enum\":[\"error\"],\"type\":\"string\"}},\"type\":\"object\"}}},\"description\