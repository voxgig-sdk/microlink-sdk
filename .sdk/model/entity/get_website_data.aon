ype\":\"string\"}},{\"description\":\"Custom HTTP headers\",\"in\":\"query\",\"name\":\"headers\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Enable iframe mode\",\"in\":\"query\",\"name\":\"iframe\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Enable insights analysis\",\"in\":\"query\",\"name\":\"insights\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Enable Lighthouse performance audit\",\"in\":\"query\",\"name\":\"lighthouse\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Detect technologies used on the website\",\"in\":\"query\",\"name\":\"technologies\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Enable or disable JavaScript execution\",\"in\":\"query\",\"name\":\"javascript\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Media type for rendering\",\"in\":\"query\",\"name\":\"mediaType\",\"required\":false,\"schema\":{\"enum\":[\"screen\",\"print\"],\"type\":\"string\"}},{\"description\":\"Enable metadata extraction\",\"in\":\"query\",\"name\":\"meta\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Enable ES modules support\",\"in\":\"query\",\"name\":\"modules\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Extract color palette from images\",\"in\":\"query\",\"name\":\"palette\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"Generate PDF from the page\",\"in\":\"query\",\"name\":\"pdf\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"PDF page format\",\"in\":\"query\",\"name\":\"pdf.format\",\"required\":false,\"schema\":{\"enum\":[\"Letter\",\"Legal\",\"Tabloid\",\"Ledger\",\"A0\",\"A1\",\"A2\",\"A3\",\"A4\",\"A5\",\"A6\"],\"type\":\"string\"}},{\"description\":\"PDF page height\",\"in\":\"query\",\"name\":\"pdf.height\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\